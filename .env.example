# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Any PostgreSQL 12+ instance works: Neon, Supabase, Vercel Postgres, RDS, Railway.
# Payload reads DATABASE_URI; DATABASE_URL (the Vercel/Neon convention) is also accepted.
DATABASE_URI=postgres://user:password@host:5432/hike_globally
# DATABASE_URL=postgres://user:password@host:5432/hike_globally

# ---------------------------------------------------------------------------
# Payload (required)
# ---------------------------------------------------------------------------
# Generate one with: openssl rand -base64 48
PAYLOAD_SECRET=replace-me-with-a-long-random-string
NEXT_PUBLIC_SITE_URL=https://hikeglobally.com

# ---------------------------------------------------------------------------
# Media storage (optional — local disk is used when unset)
# ---------------------------------------------------------------------------
# Vercel Blob: automatically present when you add a Blob store to your Vercel project.
BLOB_READ_WRITE_TOKEN=
# S3 / R2 alternative:
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=

# ---------------------------------------------------------------------------
# On-demand revalidation (optional but recommended on Vercel)
# ---------------------------------------------------------------------------
# Pass the same value as an `Authorization` header to POST /api/revalidate
REVALIDATE_SECRET=replace-me

# ---------------------------------------------------------------------------
# Inquiry form — Formsubmit.co (no backend required)
# ---------------------------------------------------------------------------
# Your verified Formsubmit.co email address.
NEXT_PUBLIC_FORMSUBMIT_EMAIL=hello@hikeglobally.com
# Where Formsubmit redirects the visitor after a successful submission.
NEXT_PUBLIC_FORMSUBMIT_SUCCESS_PATH=/inquiry/thank-you

# ---------------------------------------------------------------------------
# Email (optional — transactional mail for password resets)
# ---------------------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_NAME=Hike Globally
# SMTP_FROM_ADDRESS=no-reply@hikeglobally.com

# ---------------------------------------------------------------------------
# Local dev only: Payload disables SSL checks for self-signed DB certificates
# ---------------------------------------------------------------------------
# NODE_TLS_REJECT_UNAUTHORIZED=0
