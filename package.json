{
  "name": "hike-globally-final-project",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hike Globally — premium multilingual trekking & expedition website. Next.js App Router + Payload CMS 3 + PostgreSQL.",
