{
  "name": "hike-globally-final-project",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hike Globally \u2014 trekking & expedition website. Next.js App Router + Payload CMS 3 + PostgreSQL.",
  "license": "ISC",
  "scripts": {
    "dev": "next dev",
    "devsafe": "rm -rf .next && next dev",
    "build": "payload generate:importmap && node scripts/migrate-for-build.mjs && node scripts/typecheck-build.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "node scripts/typecheck-build.mjs",
    "test": "node --import tsx --test src/lib/*.test.ts src/storage/*.test.ts src/components/sections/*.test.ts src/components/sections/globe/*.test.ts src/migrations/tests/*.test.ts scripts/*.test.mjs",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "migrate:status": "payload migrate:status",
    "migrate:down": "payload migrate:down",
    "seed": "tsx src/scripts/seed.ts",
    "postinstall": "payload generate:importmap && patch-package",
    "generate:globe-dots": "node scripts/generate-globe-dots.mjs",
    "verify:commit-author": "node scripts/check-commit-author.mjs"
  },
  "dependencies": {
    "@carrot-kpi/switzer-font": "^0.1.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/google-sans-flex": "^5.3.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-cloud-storage": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-vercel-blob": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql": "^16.11.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.51.0",
    "motion": "^14.0.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "payload": "3.90.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "cross-env": "^10.1.0",
    "d3-geo": "^3.1.1",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.8",
    "jsdom": "^31.0.1",
    "patch-package": "^8.0.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "topojson-client": "^3.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "world-atlas": "^2.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
